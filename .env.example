# Single-tenant public SPA and protected API registrations.
ENTRA_TENANT_ID=a450efa3-cb51-43a1-b51e-44ff766fc1ac
ENTRA_FE_CLIENT_ID=c634dd6a-76b3-4240-93f3-932c999c4cf1
ENTRA_BE_CLIENT_ID=19a2bf26-c383-4fb6-b131-83b7b1af5d4e
ENTRA_API_URI=api://19a2bf26-c383-4fb6-b131-83b7b1af5d4e
# Exact delegated scope name from Expose an API (the part after the final slash).
ENTRA_CHAT_SCOPE=access-as-user
ENTRA_ADMIN_SCOPE=access-as-admin
ENTRA_ADMIN_ROLES=User.Admin
# A user needs at least one of these backend app role values.
ENTRA_CHAT_ROLES=User.Chat,User.Admin
ENTRA_REDIRECT_URI=http://localhost:8765/auth/callback

# Use the same generated URL-safe password in both settings for local Compose.
LYRA_POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://lyra:REPLACE_WITH_GENERATED_PASSWORD@127.0.0.1:55432/lyra
